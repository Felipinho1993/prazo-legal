# Servidor
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
APP_ORIGINS=http://localhost:3000

# PostgreSQL. Em produção, use uma conta exclusiva com permissões somente neste banco.
DATABASE_URL=postgresql://prazo_legal:troque-esta-senha@localhost:5432/prazo_legal
DATABASE_SSL=false
AUTO_MIGRATE=true

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
SESSION_MAX_AGE_HOURS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cadastro público. Use false se as contas forem criadas apenas pelo administrador.
ALLOW_SIGNUP=true

# E-mail para recuperação de senha (opcional em desenvolvimento, obrigatório em produção).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Prazo Legal <nao-responda@seu-dominio.com.br>
